{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "type":"object",
  "required":["version","game","locale","source","count","items"],
  "properties":{
    "version":{"type":"integer"},
    "game":{"const":"Ngôi Sao Thời Trang VNG"},
